<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, Arial, sans-serif; background: #f4f6f8; color: #17202a; }
    .container { width: min(1240px, calc(100% - 32px)); margin: 30px auto 50px; }
    .top { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
    h1 { margin: 0 0 6px; font-size: 28px; }
    h2 { margin: 0 0 18px; font-size: 20px; }
    .muted { color: #667085; font-size: 14px; }
    .card { background: white; border: 1px solid #e4e7ec; border-radius: 14px; box-shadow: 0 4px 18px rgba(16,24,40,.05); padding: 20px; margin-bottom: 22px; }
    .filter-form { display: grid; grid-template-columns: 1.4fr 1fr auto; gap: 10px; align-items: end; min-width: 520px; }
    .grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; }
    .full { grid-column: 1 / -1; }
    label { display: block; font-weight: 700; font-size: 13px; margin-bottom: 7px; }
    input, select, textarea { width: 100%; border: 1px solid #d0d5dd; border-radius: 9px; padding: 10px 12px; font: inherit; color: #101828; background: #fff; }
    input:focus, select:focus, textarea:focus { outline: 2px solid #b2ddff; border-color: #1570ef; }
    textarea { min-height: 105px; resize: vertical; }
    button, .button { border: 0; border-radius: 9px; padding: 10px 15px; font: inherit; font-weight: 700; cursor: pointer; display: inline-block; text-decoration: none; }
    .primary { background: #175cd3; color: #fff; }
    .secondary { background: #f2f4f7; color: #344054; }
    .danger { background: #d92d20; color: #fff; }
    .actions { display: flex; gap: 7px; flex-wrap: wrap; }
    .alert { border-radius: 9px; padding: 12px 14px; margin-bottom: 18px; font-size: 14px; }
    .success { background: #ecfdf3; color: #027a48; border: 1px solid #abefc6; }
    .error { background: #fef3f2; color: #b42318; border: 1px solid #fecdca; }
    .toolbar { display: flex; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .search { max-width: 460px; }
    .count { white-space: nowrap; color: #667085; font-size: 14px; }
    .table-wrap { overflow-x: auto; border: 1px solid #eaecf0; border-radius: 10px; }
    table { width: 100%; border-collapse: collapse; min-width: 950px; }
    th, td { border-bottom: 1px solid #eaecf0; padding: 12px; text-align: left; vertical-align: top; font-size: 13px; }
    th { background: #f9fafb; color: #475467; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
    tr:last-child td { border-bottom: none; }
    .param-name { font-family: Consolas, monospace; font-weight: 700; word-break: break-all; }
    .value-cell { max-width: 410px; word-break: break-word; white-space: pre-wrap; font-family: Consolas, monospace; }
    .badge { display: inline-block; padding: 4px 7px; border-radius: 999px; background: #f2f4f7; color: #344054; font-size: 11px; font-weight: 700; }
    .empty { text-align: center; padding: 40px 20px; color: #667085; }
    .notice { margin-top: 8px; font-size: 12px; color: #667085; }
    .edit-banner { display: none; background: #eff8ff; border: 1px solid #b2ddff; padding: 10px 12px; border-radius: 8px; margin-bottom: 14px; }
    @media (max-width: 900px) {
      .top { display: block; }
      .filter-form { min-width: 0; grid-template-columns: 1fr; margin-top: 18px; }
      .grid { grid-template-columns: 1fr; }
      .toolbar { display: block; }
      .search { max-width: none; margin-bottom: 10px; }
    }
  </style>
</head>
<body>
<div class="container">
  <div class="top">
    <div>
      <h1>AWS SSM Parameter Manager</h1>
      <div class="muted">Add, update, search and delete AWS Systems Manager Parameter Store values.</div>
    </div>

    <form method="GET" action="/ssm" class="filter-form">
      <div>
        <label for="load-path">SSM Path</label>
        <input id="load-path" name="path" value="<%= path %>" placeholder="/womancart/">
      </div>
      <div>
        <label for="load-region">AWS Region (optional)</label>
        <input id="load-region" name="region" value="<%= region %>" placeholder="ap-south-1">
      </div>
      <button class="primary" type="submit">Load</button>
    </form>
  </div>

  <% if (success) { %><div class="alert success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>

  <div class="card" id="parameter-form-card">
    <h2 id="form-title">Add SSM Parameter</h2>
    <div class="edit-banner" id="edit-banner">
      You are editing an existing parameter. Saving will overwrite its current value.
      <button type="button" class="secondary" style="float:right; padding:5px 9px" onclick="resetForm()">Cancel edit</button>
      <div style="clear:both"></div>
    </div>

    <form method="POST" action="/ssm/save" id="parameter-form">
      <input type="hidden" name="path" value="<%= path %>">
      <!-- <input type="text" name="region" value="<%= region %>"> -->

      <div class="grid">
        <div>
          <label for="name">Parameter Name</label>
          <input id="name" name="name" placeholder="/womancart/production/DB_HOST" required>
        </div>
        <div>
          <label for="type">Type</label>
          <select id="type" name="type">
            <option value="String">String</option>
            <option value="StringList">StringList</option>
            <option value="SecureString">SecureString</option>
          </select>
        </div>
        <div class="full">
          <label for="value">Value</label>
          <textarea id="value" name="value" placeholder="Parameter value" required></textarea>
        </div>
        <div class="full">
          <label for="description">Description (optional)</label>
          <input id="description" name="description" placeholder="What this parameter is used for">
        </div>
        
        <div>
          <label for="name">Select region</label>
          <input type="text" name="region" value="<%= region %>">
        </div>
        <div class="full actions">
          <button class="primary" type="submit" id="save-button">Add Parameter</button>
          <button class="secondary" type="button" id="reset-button" onclick="resetForm()">Clear</button>
        </div>
      </div>
    </form>
    <div class="notice">SecureString values are decrypted for this local management screen. Keep this application private.</div>
  </div>

  <div class="card">
    <div class="toolbar">
      <input class="search" id="search" type="search" placeholder="Search parameter name, value or type..." oninput="filterTable()">
      <div class="count"><span id="visible-count"><%= parameters.length %></span> / <%= parameters.length %> parameters</div>
    </div>

    <% if (!parameters.length) { %>
      <div class="empty">No parameters found for <strong><%= path %></strong>.</div>
    <% } else { %>
      <div class="table-wrap">
        <table id="parameters-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Value</th>
              <th>Type</th>
              <th>Version</th>
              <th>Last modified</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          <% parameters.forEach((parameter, index) => { %>
            <tr class="parameter-row"
                data-search="<%= (parameter.name + ' ' + parameter.value + ' ' + parameter.type).toLowerCase() %>">
              <td class="param-name"><%= parameter.name %></td>
              <td class="value-cell"><%= parameter.value %></td>
              <td><span class="badge"><%= parameter.type %></span></td>
              <td><%= parameter.version %></td>
              <td><%= parameter.lastModifiedDate ? new Date(parameter.lastModifiedDate).toLocaleString() : '-' %></td>
              <td>
                <div class="actions">
                  <button
                    type="button"
                    class="secondary"
                    data-name="<%= parameter.name %>"
                    data-value="<%= parameter.value %>"
                    data-type="<%= parameter.type %>"
                    onclick="editParameter(this)">Edit</button>

                  <form method="POST" action="/ssm/delete" onsubmit="return confirmDelete(this)">
                    <input type="hidden" name="path" value="<%= path %>">
                    <input type="hidden" name="region" value="<%= region %>">
                    <input type="hidden" name="name" value="<%= parameter.name %>">
                    <button class="danger" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  function filterTable() {
    const query = document.getElementById('search').value.trim().toLowerCase();
    const rows = document.querySelectorAll('.parameter-row');
    let visible = 0;

    rows.forEach((row) => {
      const match = !query || row.dataset.search.includes(query);
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    document.getElementById('visible-count').textContent = visible;
  }

  function editParameter(button) {
    document.getElementById('name').value = button.dataset.name;
    document.getElementById('value').value = button.dataset.value;
    document.getElementById('type').value = button.dataset.type;
    document.getElementById('form-title').textContent = 'Update SSM Parameter';
    document.getElementById('save-button').textContent = 'Update Parameter';
    document.getElementById('edit-banner').style.display = 'block';
    document.getElementById('parameter-form-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetForm() {
    document.getElementById('parameter-form').reset();
    document.getElementById('form-title').textContent = 'Add SSM Parameter';
    document.getElementById('save-button').textContent = 'Add Parameter';
    document.getElementById('edit-banner').style.display = 'none';
  }

  function confirmDelete(form) {
    const name = form.querySelector('input[name="name"]').value;
    return window.confirm(`Delete SSM parameter?\n\n${name}\n\nThis action cannot be undone.`);
  }
</script>
</body>
</html>
